# Local development only. Never commit a real .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_COOKIES=false
SECURE_SSL_REDIRECT=false
DB_NAME=gvp
DB_HOST=localhost
# Dev logs in as the cluster admin and switches to the least-privilege roles.
DB_USER=gvp_admin
DB_PASSWORD=gvp_admin
DB_ASSUME_ROLE=app_rw
PLATFORM_DB_ASSUME_ROLE=app_platform
